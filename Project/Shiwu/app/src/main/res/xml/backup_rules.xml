<?xml version="1.0" encoding="utf-8"?><!--
  云端备份规则（API < 31）。
  deviceId / 序列分配器 / gid_migrated 存放于 noBackupFilesDir/device_state.json，
  该目录不会被 Android 备份；不要把这些字段再写入 sharedpref，
  也不要在 include 中包含 no_backup 目录，否则换机克隆会复用同一 deviceId。
  昵称、主题、清单锁、WebDAV 配置等仍保留在 shiwu_prefs 中。
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>